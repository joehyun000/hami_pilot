# 실제 값은 configs/k8s.env에 복사해 적는다.
# configs/k8s.env는 Git에 올라가지 않는다.
PILOT_K8S_NAMESPACE="your-namespace"
PILOT_K8S_BUILD_NODE="your-gpu-node"
PILOT_NFS_SERVER="your-nfs-server"
PILOT_NFS_ROOT="/path/to/nfs/export"
PILOT_REGISTRY="ghcr.io/your-account"
PILOT_REGISTRY_USERNAME="your-github-username"
PILOT_REGISTRY_SECRET="hami-pilot-registry"
PILOT_REGISTRY_INSECURE="false"
