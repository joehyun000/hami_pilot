# 이 파일을 configs/server.env로 복사한 뒤 서버의 실제 값을 적으세요.
# 경로에 공백이 있을 수 있으므로 따옴표를 유지하세요.

PILOT_MODEL_FILE="/absolute/path/model.pytorch"
PILOT_DATASET_FILE="/absolute/path/dev-v1.1.json"
PILOT_VOCAB_FILE="/absolute/path/vocab.txt"

# 낮은 값부터 시험할 초당 요청 수 후보들입니다.
PILOT_CANDIDATE_QPS="1 2 4 8"

PILOT_GPU_INDEX="0"
PILOT_OUTPUT_DIR="runs/bert-pilot"

# 실제 GPU가 지원하는 값을 확인한 뒤 입력하세요.
PILOT_GPU_CLOCK_MHZ=""

# 준비·요청량 선정·짧은 확인·본 실험 시작 전에 이 온도 이하를 기다립니다.
# 30회 내부의 각 실험 직전 냉각을 강제하는 기능은 아닙니다.
PILOT_MAX_START_TEMP_C="55"
PILOT_TEMPERATURE_WAIT_SECONDS="900"
